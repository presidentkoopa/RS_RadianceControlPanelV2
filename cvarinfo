// ---- The spin --------------------------------------------------------------
// A sweep's origin can ORBIT instead of sitting still. Parked on the player
// (Starts from = Follows you) with the speed low, the ring stops travelling
// and its centre circles your feet instead -- the bright edge rakes around the
// room, and with spin colours on, the palette is thumbed through as it turns.
server float gitd_ss_spin = 0.0;         // degrees per second; 0 = no spin
server float gitd_ss_spin_radius = 0.0;  // how far the origin orbits
server int   gitd_ss_spin_colors = 0;    // 0 off, else cycle this many colours

// ---- What each sweep DOES to the pixels it covers ---------------------------
// 1 add    -- emits light, additively. A glowing line.
// 2 lift   -- multiplies what is there UP. A reveal: darkness pulled aside,
//             per pixel, so a big room reveals in a moving strip rather than
//             switching on whole.
// 3 crush  -- multiplies down. A travelling darkness.
server int gitd_ss_draw1 = 1;
server int gitd_ss_draw2 = 1;
server int gitd_ss_draw3 = 1;
server int gitd_ss_draw4 = 1;
server int gitd_ss_draw5 = 1;
server int gitd_ss_draw6 = 1;
server int gitd_ss_draw7 = 1;
server int gitd_ss_draw8 = 1;

// ---- Per-sweep thickness ---------------------------------------------------
// 0 means "use the shared Thickness slider", which is what every band did
// before this existed. A band is twice its thickness wide, so thickness over
// speed is how many seconds it takes to cross you -- a thin fast band is a
// snap, a thick slow one is weather.
server int gitd_ss_thick1 = 0;
server int gitd_ss_thick2 = 0;
server int gitd_ss_thick3 = 0;
server int gitd_ss_thick4 = 0;
server int gitd_ss_thick5 = 0;
