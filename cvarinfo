// ---- Per-sweep speed -------------------------------------------------------
// Each band in the train may travel at its own rate. Sweep 1 is the LEADER and
// its speed is the clock; the others are expressed against it, so a band at
// double sweep 1's speed covers twice the ground in the same time. Setting all
// eight the same reproduces the old single-speed train exactly.
//
// gitd_ss_speed remains the fallback for anything that has no per-band value
// and for scripted waves, which carry their own speed.
server float gitd_ss_speed1 = 260.0;
server float gitd_ss_speed2 = 260.0;
server float gitd_ss_speed3 = 260.0;
server float gitd_ss_speed4 = 260.0;
server float gitd_ss_speed5 = 260.0;
server float gitd_ss_speed6 = 260.0;
server float gitd_ss_speed7 = 260.0;
server float gitd_ss_speed8 = 260.0;

