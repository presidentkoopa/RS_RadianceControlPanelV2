// === GLOW IN THE DARK ===
//
// Four lanes, identical control set on each:
//   wb = wall bottom, lit from the floor     (wall glow)
//   wt = wall top, lit from the ceiling      (wall glow)
//   cg = the ceiling surface itself          (flat-edge glow)
//   fg = the floor surface itself            (flat-edge glow)
//
// Colour slots are palette indices, not raw colours -- see GITD_Palette in
// zscript/GlowHandler.zs. Slot value -1 means "random", re-rolled each time
// that slot comes around.

server bool gitd_enabled = true;

// Bloom is what makes glow read as emissive rather than as paint, so GITD
// switches it on the first time it loads. Once only -- after that your
// choice sticks, because a mod that keeps overriding a setting you changed
// is worse than one that never touched it.
user bool gitd_bloom_forced = false;
server bool gitd_dd_enabled = true;      // DarkDoomZ master

// Preset 0 = off (player's own colour choices are used).
// 1-10 override every lane's colours while active.
server int gitd_preset = 0;

