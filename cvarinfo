// === NEON NUMERIC ENGINE ===
//
// In-world text and numbers. The engine draws them; these decide how.
//
// gitd_neon_style picks between three payloads that a player experiences as
// one setting: a real typeface, a segment display, or that display inverted.
// The segment looks need no font asset at all -- their glyphs are arithmetic.
//
// Colour here is only a FALLBACK. Any mod that knows what a number means
// passes its own and never reads this.
server bool  gitd_neon_enabled        = true;
server int   gitd_neon_style          = 3;      // 0 font, 1 LED seg, 2 LCD seg, 3 wgType 13 (default)
server color gitd_neon_color          = "00 c8 ff";
server float gitd_neon_scale          = 0.55;   // 0.10 .. 3. Below 1 by default: GITD's
                                                // sizes were for a floor decal, and a
                                                // camera-facing badge at the same numbers
                                                // fills the screen.
server float gitd_neon_life           = 2.5;    // seconds a fire-and-forget number lasts
// Reach is a fraction of the atlas spread and cannot usefully exceed 1 --
// past that there is no field left to read and the halo clips square.
server float gitd_neon_glow_reach     = 0.6;
server float gitd_neon_glow_strength  = 0.75;

// Kill counter. Off by default -- it is a readout, not everyone wants one.
// Readouts. Each is a different SOURCE feeding the same display -- the engine
// draws numbers, these decide which numbers exist.
server bool gitd_neon_killcount = false;
server bool gitd_neon_damage    = false;   // damage numbers, overhead
server int  gitd_neon_dmg_mode  = 1;       // 0 one per hit, 1 accumulate per monster
server int  gitd_neon_dmg_window = 45;     // tics of quiet before a total expires
server int  gitd_neon_kc_place  = 0;   // 0 flat on the ground, 1 above the corpse.
                                       // Either, never both. A stale 2 reads as 0.
server int  gitd_neon_kc_linger = 0;   // 0 close again, 1 fade out, 2 stay put
server int  gitd_neon_kc_digits = 4;   // zero-padded width, so it does not
                                       // change size as it counts

// Suppress vanilla's muzzle-flash view brightening (player.extralight). ON by
// default: it is barely noticeable in a lit game and ruins a dark one, since
// near-black to lit is a far larger jump than lit to lighter.
server bool gitd_dd_noflash = true;

// Desaturation applied with the darkness tint, 0-255. Colour vision fails at
// low light, so draining saturation as the level darkens reads as genuinely
// dark rather than merely dim. 0 keeps full colour.
server int ddz_desat = 0;

