server int gitd_ss_thick7 = 0;
server int gitd_ss_thick8 = 0;

// ---- Dropped sweeps --------------------------------------------------------
// A sweep that happens WHERE IT WAS TRIGGERED and stays there, instead of the
// configured sweep following the player around. Walk a corridor and you leave
