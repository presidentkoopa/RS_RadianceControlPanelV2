// ---- Sector Sweep ---------------------------------------------------------
// A train of up to eight thin bands of light travelling through the world,
// each wrapping across floor, wall and ceiling as one continuous line. Its
// own system, not one of the four lanes and not a preset: while it is on it
// takes over, because the whole point is a clean dark room with nothing in
// it but the lines.
//
// Bands follow each other at a configurable spacing in tics, so band 2
// starts N tics behind band 1 and so on down the train.
server bool gitd_ss_enabled = false;
server int gitd_ss_shape = 2;        // 1 ring, 2 bar east/west, 3 bar north/south, 4 shell
server int gitd_ss_count = 1;        // how many bands in the train, 1-8
server int gitd_ss_origin = 0;       // 0 map centre, 1 where you started, 2 follows you

server color gitd_ss_c1 = "00 dc ff";
server color gitd_ss_c2 = "00 dc ff";
server color gitd_ss_c3 = "00 dc ff";
server color gitd_ss_c4 = "00 dc ff";
server color gitd_ss_c5 = "00 dc ff";
server color gitd_ss_c6 = "00 dc ff";
server color gitd_ss_c7 = "00 dc ff";
server color gitd_ss_c8 = "00 dc ff";

// Tics between one band starting and the next. gap1 is the delay before
// band 2 follows band 1, and so on.
server int gitd_ss_gap1 = 20;
server int gitd_ss_gap2 = 20;
server int gitd_ss_gap3 = 20;
server int gitd_ss_gap4 = 20;
server int gitd_ss_gap5 = 20;
server int gitd_ss_gap6 = 20;
server int gitd_ss_gap7 = 20;

// What the sweep does to the room it passes through.
//   0 nothing
//   1 brighten each sector as a band crosses it
//   2 darken each sector as a band crosses it
//   3 re-colour the four glow lanes to shades of the band's own colour
server int gitd_ss_light_mode = 0;
server int gitd_ss_light_amount = 48;   // how much brighter/darker, in light units

server float gitd_ss_intensity = 1.4;
server int gitd_ss_thickness = 10;
server float gitd_ss_softness = 2.0;
server float gitd_ss_speed = 260.0;     // map units per second
server int gitd_ss_range = 2048;        // how far a band travels before restarting
server bool gitd_ss_pingpong = true;    // sweep back and forth instead of restarting

// ---- Flashlight -----------------------------------------------------------
// Volumetric: the beam is visible in the air, not just where it lands. The
// cone itself is drawn by the engine (Level.SetVolumetricBeam); everything
// here decides where it points and what colour it is.
server bool fl_enabled = true;
server int fl_mount = 0;          // 0 mainhand, 1 offhand, 2 head, 3 chest
server bool fl_allowflip = true;  // flip the beam when the wrist rolls past upside-down
server bool fl_bounce = false;    // OFF by default. It is a PointLight at the lens --
                                  // omnidirectional fill, which is the opposite of what a
                                  // torch is. It softens a harsh cone in a black room, and
                                  // it also makes the beam read as "just a light". Opt in.
server bool fl_agitate = false;   // pointing the light at monsters wakes them
server bool fl_model = false;     // show the flashlight model -- requires the offhand mount

// Shape.
server int fl_range = 1024;
server float fl_intensity = 1.0;
server float fl_inner = 10.0;     // half-angle, degrees: full brightness inside this
server float fl_outer = 26.0;     // half-angle, degrees: faded out by here
server float fl_falloff = 1.5;    // 1 linear along the beam, higher concentrates it near the lens
server float fl_density = 1.8;    // the beam lights its own haze -- this is what makes
                                  // it a visible SHAFT rather than a bright patch where it
                                  // lands. Independent of sector fog and of floor fog.

