// ---- Laser grid --------------------------------------------------------
//
// THE LASER GRID IS NOT ITS OWN SYSTEM. It is what a sector sweep fires into
// the air, and it lives on the sweep's own page under "In the air"
// (gitd_ss_fill_air, with the lattice's spacing, width and colour beside it).
//
// It used to be a separate toggle that placed eight real beam segments in a
// rectangle riding the sweep. Eight is a fence, not a screen door, and the
// rectangle was a small panel floating in a big room rather than a wall of
// light filling the corridor -- which is what the thing is supposed to be.
// Raising the beam count would have made it worse, because every beam is
// another segment solve for every pixel on screen.
//
// The lattice is a PATTERN evaluated where the view ray crosses the band's
// plane, so four lines by four and four hundred by four hundred cost exactly
// the same. That is what makes a screen door affordable, and it is why the
// grid became part of the sweep instead of competing with it.

// THE SURFACE, ANIMATED. A flat top is a horizontal plane, and once you can
// see it clearly that is what it reads as -- a sheet, not a body of mist.
//
// Two waves at an angle to each other, on purpose. One sine corrugates:
// parallel ridges marching in a single direction, which reads as machinery.
// A second at an angle and a different period makes them interfere, and
// interference is what looks like a surface rolling rather than a pattern
// scrolling.
server float gitd_fog_surf = 7.0;        // units the top rises and falls; 0 = flat -- ON: a dead-flat top is the single biggest tell that mist is a plane and not air
server float gitd_fog_surf_len = 256.0;  // wavelength
server float gitd_fog_surf_speed = 1.0;
server float gitd_fog_surf_cross = 0.6;  // strength of the second, angled wave

// THE LATTICE, IN THE AIR.
//
// The fill above patterns the band where it lands on a SURFACE -- a grid
// painted on the walls, which wraps corners and has nothing between them.
// This draws the same lattice hanging in the air inside the band, so you can
// walk into it.
//
// It is a PATTERN, not a set of lines: the view ray crosses the band's plane
// at one point and the grid is evaluated there. So 4x4 and 400x400 cost
// exactly the same, and density is free -- which is the whole reason this
// exists rather than more beams.
//
// Everything else about it comes from the fill controls above: colour,
// spacing, width, softness, rotation, drift, flicker, jitter, major lines.
// One set of controls, both versions, so they cannot drift apart.
//
// 0 = painted only, as before. Bars only -- ring and shell fall back to the
// painted version, because a ray meets a cylinder in two places.
server float gitd_ss_fill_air = 0.0;

// THE LAYER'S BOTTOM.
//
// Without one the fog is a half-space -- everything below a height -- which
// can only ever be mist lying on the floor. With one it is a LAYER, and that
// single number is four different effects:
//
//   floor fog     bottom far below, top at the knee (the default)
//   CEILING FOG   bottom near the ceiling, top above it
//   a floating band at chest height
//   drain and fill, by animating one edge toward the other
//
// -32768 is "no bottom", and leaves everything exactly as it was.
server float gitd_fog_bottom = -32768.0;

// VERTICAL HOLD.
//
// The layer repeats up the room every PERIOD units, and ROLL slides the whole
// stack through that spacing -- the old television fault, where the picture
// will not hold still and keeps rolling past the top.
//
// It costs nothing beyond the single layer, because a repeat is arithmetic
// rather than a loop: one mod() and the same two smoothsteps. Twenty layers
// or one is the same instruction count.
//
// 0 is off and means "one layer", which is why the slider's floor is 0 rather
// than some minimum spacing -- off has to be reachable by dragging left.
server float gitd_fog_period = 0.0;
server float gitd_fog_roll = 0.0;   // units per second; negative rolls down

// ---------------------------------------------------------------------------
// THE TORNADO
//
// The same fog gathered around a vertical axis instead of spread under a
// plane. Density near a line rather than density below a height, and every
// other question the shader asks is unchanged -- which is why this is a shape
// on the existing volumetric rather than a second system.
//
// YOU CAN STAND INSIDE IT. The centre is left hollow, so from within you are
// looking out through the far wall of the funnel and the room beyond it is
// still there, dimmed and moving. That is not a concession to performance,
// it is what one looks like from the inside.
//
// IT IS THE EXPENSIVE ONE. A floor layer stops costing anything the moment
// you look up; a funnel is on screen from every angle that can see it, and it
// is evaluated per fragment. Density 0 is tested first and switches the whole
// block off, so leaving it off is genuinely free.
// ---------------------------------------------------------------------------
server bool  gitd_tornado_enabled = false;

// 0 fixed world point (the sliders below are absolute)
// 1 where you spawned   2 you   3 last shot   4 last kill   5 nearest monster
//
// Anything but 0 makes the position sliders an OFFSET from that anchor, so
// "beside me, not on me" needs no extra mode.
server int   gitd_tornado_origin = 0;
server float gitd_tornado_x = 0.0;
server float gitd_tornado_y = 0.0;

// The extent. Base and top are world heights; the radii are what it measures
// at each. Wide at the top and pinched at the bottom is the shape everyone
// pictures, and the flare between them runs on a curve rather than a straight
// taper because the pinch near the ground is most of the silhouette.
server float gitd_tornado_base = 0.0;
server float gitd_tornado_top = 512.0;
server float gitd_tornado_rad_base = 48.0;
server float gitd_tornado_rad_top = 320.0;
server float gitd_tornado_density = 1.0;

// SWIRL is what reads as rotation: three arms of density around the axis,
// twisting as they climb and turning as time passes. With it at 0 the funnel
// is a smooth cone of haze and looks like weather on a screensaver.
//
// TWIST is how much those arms wind up between the base and the top, and it
// is what makes the rotation legible -- straight arms turning look like a
// spinning fence, wound ones look like something being drawn upward.
//
// LEAN pushes the axis off vertical by an amount that grows with height, on
// its own slow period, so the whole column sways. Zero is a traffic cone.
server float gitd_tornado_swirl = 0.5;
server float gitd_tornado_spin = 2.0;
server float gitd_tornado_twist = 8.0;
server float gitd_tornado_lean = 0.0;
server float gitd_tornado_lean_period = 6.0;

// ITS OWN COLOUR, AND ITS OWN TORCH.
//
// The funnel used to be whatever colour the floor fog was, because it shared
// the layer's accumulator and one number cannot say which shape a pixel's mist
// came from. It carries its own now, and the two are merged weighted by how
// much each actually contributed -- so a red column standing in blue ground
// mist reads as two mists mingling where they cross, rather than one winning.
//
// Scatter is separate for the same reason and a sharper one: the layer's
// scatter dial is pushed by SetFogSlab, so it reads zero whenever floor fog is
// switched off -- which is exactly the case where a funnel standing alone in
// clear air needs the torch to pick it out of the dark.
server color gitd_tornado_color = "8c 99 b3";
server float gitd_tornado_scatter = 1.2;

// ===========================================================================
// REACTIVE FOG
//
// Everything below is one idea: the mist is a substance in the room, not a
// filter over the picture, and a substance responds to what happens in it.
// ===========================================================================

// ---- Density is not one number --------------------------------------------
//
// Uniform density is the single biggest tell that fog is a filter. Real mist
// banks: thick in the corners, thin across the open floor. One noise sample
// scaling the density fixes that, and drifting the field slowly makes the
// banks move through the room on their own with nothing animated.
//
// Sampled at the midpoint of the eye-to-pixel line rather than at the pixel,
// because the fog for a pixel is an integral along that whole line. Sample at
// the far end and the banks appear pinned to the walls.
//
// Depth 0 restores exactly the old uniform behaviour.
server float gitd_fog_noise = 0.55;       // 0 = uniform, 1 = strongly banked -- ON: a uniform slab reads as a filter, not a volume
server float gitd_fog_noise_scale = 0.004; // smaller = larger, slower banks
server float gitd_fog_noise_drift = 11.0;   // units per second the field moves

// ---- The wake, stretched --------------------------------------------------
//
// A disc is a hole you carry around with you. An ellipse drawn out behind is
// a corridor you carve and leave. Only the trailing half stretches -- doing
// both ends would clear as much air in front of you as behind, which is a
// bubble and not a wake.
server float gitd_fog_wake_stretch = 0.0;

// ---- Disturbances ---------------------------------------------------------
//
// A gunshot ring, an explosion igniting the mist, a monster shouldering
// through it. All the same primitive: a point, a radius, an age, a strength
// and a sign. Eight at once, oldest recycled, each decaying over its life.
//
// A ring recoiling from your muzzle is the one that sells fog as a physical
// medium, because it proves the mist is BETWEEN you and the wall rather than
// painted on it.
server bool  gitd_fog_react = true;
server float gitd_fog_react_shot = 0.85;   // ring from your own gunfire
server float gitd_fog_react_shot_size = 88;
server float gitd_fog_react_death = 1.15;  // burst where a monster dies
server float gitd_fog_react_death_size = 130;
server float gitd_fog_react_ignite = 1.4;  // explosions LIGHT the mist (mode 2)
server float gitd_fog_react_ignite_size = 140.0; // radius of that flash
server int   gitd_fog_react_mode = 1;      // 0 disc, 1 ripple, 2 ignite, 3 gout
server float gitd_fog_react_speed = 320.0; // how fast a ring travels outward
server float gitd_fog_react_life = 1.6;    // seconds before it has faded out

// ---- Displacers -----------------------------------------------------------
//
// Monsters shoulder the mist aside. Uses the same eight slots, so a busy
// firefight spends them on whatever happened most recently -- which is the
// right answer, since that is also what you are looking at.
server float gitd_fog_displace = 0.45;     // 0 = actors do not touch the mist -- ON: a monster walking through mist that ignores it is the tell
server float gitd_fog_displace_size = 64;
server int   gitd_fog_displace_count = 4;  // how many of the nearest to track

// ---- Tendrils -------------------------------------------------------------
//
// Wisps rising off the surface. A lattice rather than a set of objects: one
// per cell of a fract() grid, so four hundred of them cost what one costs.
// The tornado's own maths at small scale.
server float gitd_fog_tendril = 0.30;      // 0 = off -- ON: wisps rising off the surface are what sell it as moving air
server float gitd_fog_tendril_spacing = 96.0;
server float gitd_fog_tendril_radius = 10.0;
server float gitd_fog_tendril_height = 96.0;
server float gitd_fog_tendril_rise = 0.6;
server float gitd_fog_tendril_lean = 6.0;
server float gitd_fog_tendril_taper = 1.6;

// ---- The sweep moves the air ----------------------------------------------
//
// A wall of light travelling through a room ought to move the room. Mist
// piles against the leading face and is scoured out behind, which costs one
// evaluation of a distance function the band already computes.
server float gitd_fog_bow = 0.0;
server float gitd_fog_bow_width = 64.0;
server float gitd_fog_bow_thin = 0.6;      // how much is scoured out behind

// ---- Two colours through the layer ----------------------------------------
//
// Cold at the floor, warm at the top. Measured against the layer's own
// thickness, so it means the same thing in a chest-high band as in knee-deep
// ground mist, and it follows the top as the surface swells.
server color gitd_fog_color2 = "b3 80 59";
server float gitd_fog_color2_mix = 0.0;

// ===========================================================================
// THE HEATMAP -- where the fighting happened.
//
// Every death drops a mark on the floor and the marks accumulate over the
// whole life of the map. Walk back through somewhere you cleared and the
// ground remembers it.
//
// Not the disturbance array: that is eight short-lived events, and this is
// hundreds of permanent deposits that have to be SUMMED. A sum wants a bucket,
// not a list, so it is a grid over the map's own bounding box -- which is why
// the thousandth death costs exactly what the first one cost.
//
// It is also readable from script, so a spawn director can weight against
// ground that has already been fought over. That is the part that makes it a
// design tool rather than only a picture.
// ===========================================================================
server bool  gitd_heat_enabled = false;
server float gitd_heat_scale = 0.8;      // how strongly it tints the floor
// Radius of ONE deposit, in world units. 96 was a 6-metre stain per corpse --
// two kills in a corridor merged into one wash and the map lost the ability to
// say WHERE the fighting was, which is the only thing it is for. 48 is about
// the width of a door: still unmistakable underfoot, still legible from across
// a room, and two bodies a few paces apart read as two.
server float gitd_heat_size = 48.0;      // world radius of one deposit
server float gitd_heat_amount = 1.0;     // how much one death contributes
server float gitd_heat_ceiling = 8.0;    // total that reaches the high colour
server color gitd_heat_low = "20 40 ff"; // one death
server color gitd_heat_high = "ff 20 00";// a massacre
server float gitd_heat_decay = 0.0;      // per second; 0 = it never forgets
server float gitd_heat_tolerance = 96.0; // Z difference that counts as another
                                         // storey rather than the same floor

// Deposits from things other than deaths. Player damage marks where YOU were
// hurt, which is a different map from where things died -- and the pair of
// them together is the actual shape of a fight.
server float gitd_heat_hurt = 0.0;

// ---- What survives the colour drain ---------------------------------------
//
// Colour drain (ddz_desat) used to be all or nothing: a monochrome world made
// blood exactly as grey as the wall it was sprayed on.
//
// This weights the drain by each colour's OWN saturation, so the vivid things
// keep their colour and everything else goes grey -- Sin City rather than
// Ingmar Bergman. Nothing is tagged: no actor, sprite or texture has to know
// it is exempt, because the rule is about the colour and not about the thing.
//
// It reaches everything for the same reason. There is exactly one desaturate
// function in the fragment shader and every path goes through it -- textures,
// sprites, glow, sweep bands, brightmaps -- so a rule added there cannot
// disagree with itself.
//
// 0 is off and restores the old behaviour exactly.
//
// Doom's palette is very saturated at the top end, so 0.75 keeps blood and
// pickups while brown walls (around 0.55) still drain. Lower it and more
// survives; raise it and only the purest colours do.
server float gitd_dd_keep = 0.0;
server float gitd_dd_keep_soft = 0.15;

// 0 any hue, 1 red only, 2 green only, 3 blue only.
//
// Any-hue keeps every vivid thing, which is its own look. Red-only is the one
// that means "blood, and nothing else" -- a green nukage pool at full
// saturation drains with the walls.
server int gitd_dd_keep_hue = 0;

// ===========================================================================
// TEXTURE INSIDE THE GLOW
//
// The glow wave varies a lane's EDGE. That is the right answer while the edge
// is on screen, and no answer at all once coverage saturates -- turn reach up
// far enough and the wall is a solid card of colour with a wave moving a
// boundary nobody can see any more.
//
// Everything here happens WITHIN the lit area instead, so a maxed-out lane
// still has somewhere to go. All five are multipliers on the glow's finished
// contribution, so none of them can move a band's shape: the wave owns shape,
// these own substance.
//
// Sampled in WORLD space, not per surface, so a pattern crossing a wall/floor
// join does not restart at the corner -- it reads as something the room is
// made of rather than a decal stuck on each face.
// ===========================================================================

// ---- 1. Noise: the wash gets body -----------------------------------------
//
// A lit wall is currently one flat brightness across its whole face. Real
// glowing material is veined and uneven. This is the same move the fog's
// density field makes, for the same reason: a uniform value is the biggest
// single tell that something is a filter rather than a substance.
server float gitd_gtex_noise = 0.0;      // 0 = flat, as before
server float gitd_gtex_scale = 0.02;     // smaller = larger, softer patches
server float gitd_gtex_drift = 1.0;      // how fast the field moves through
server float gitd_gtex_contrast = 1.0;   // 1 = gentle mottle, high = plasma

// ---- 2. Flow: current along the surface -----------------------------------
//
// The wave arrives FROM an origin. This travels ALONG the surface -- a
// different axis of motion entirely, and it reads as current running through
// the material rather than weather passing over it.
//
// The axis comes from the surface normal, so it means the same thing
// everywhere: vertical on a wall, along world X on a floor or ceiling.
server float gitd_gflow = 0.0;
server float gitd_gflow_spacing = 64.0;  // world units between bands
server float gitd_gflow_speed = 0.4;
server float gitd_gflow_sharp = 2.0;     // 1 = broad swell, high = thin lines

// ---- 3. Cells: veins with light crawling them -----------------------------
//
// The lattice trick from the sweep, made organic. Lighting the distance to
// the nearest CELL EDGE rather than the cell body gives veins instead of
// tiles, and each cell pulses on its own hashed clock so the network crawls
// rather than blinking as one.
//
// Free at any density, exactly like the laser lattice: this is a pattern, not
// a set of objects.
server float gitd_gcell = 0.0;
server float gitd_gcell_scale = 96.0;    // world size of one cell
server float gitd_gcell_speed = 1.2;
server float gitd_gcell_width = 0.08;    // vein thickness; low = hairlines

// ---- 4. The walls react too -----------------------------------------------
//
// The disturbance array already exists and already fires on gunfire and on
// death -- until now only the fog consumed it. Feeding the same eight slots
// into the glow costs nothing to build and makes a shot visibly travel across
// the lit surfaces of a room rather than only through the air in it.
//
// Needs Reactive Fog's events on; it shares those slots. Rings only, because
// a disc that dimmed the wall would read as damage to the light rather than
// as a pulse through it.
server float gitd_greact = 0.0;

// ---- 5. The room knows something is wrong ---------------------------------
//
// One level, driven from the world, pulsing every glow at once. The lane
// stops being decoration and starts carrying information, which is the one
// thing none of the four above can do however good they look.
//
// The rate rises with the level as well as the depth, because faster is what
// reads as urgency -- brighter alone just reads as brighter.
server float gitd_gpulse = 0.0;          // depth of the pulse
server int   gitd_gpulse_src = 1;        // 0 manual, 1 monsters near you,
                                         // 2 your health, 3 both
server float gitd_gpulse_range = 768.0;  // how near counts, for source 1
server int   gitd_gpulse_count = 6;      // monsters that means "fully alarmed"
server float gitd_gpulse_level = 0.0;    // the manual level, for source 0

// ===========================================================================
// SHAPES ON THE FLOOR
//
// Signed distance fields drawn onto surfaces. A shape is maths rather than
// geometry -- no model, no actor, no sprite -- so it is pin-sharp at any
// distance, wraps a step without seams, and costs a couple of instructions
// behind an early reject.
//
// Sixteen at once, oldest recycled.
//
// THE SEAM IS THE ONE TO SEE. A shape splits down its middle and a second
// colour shows through the widening gap -- subtraction, masked by the shape it
// came out of, so the reveal never bleeds past the edge that split.
// ===========================================================================
server bool  gitd_shape_enabled = false;

// 128 slots, and the shader loops only to the highest one in use -- so the cap
// costs nothing until it is spent. The per-fragment reject is a squared-radius
// compare, which is what makes a large number of small marks affordable: a
// pixel is near almost none of them.
//
// If you want HUNDREDS of similar shapes rather than hundreds of distinct
// ones, slots are the wrong tool -- a repeated pattern is one slot and free at
// any density, the same trick the laser lattice and the tendrils use.

// 1 disc, 2 ring, 3 square, 4 square outline, 5 cross, 6 hexagon, 7 triangle
server int   gitd_shape_kind = 2;
server int   gitd_shape_orient = 0;      // 0 floors, 1 walls, 2 any surface
server float gitd_shape_size = 64.0;
server float gitd_shape_thick = 6.0;     // ring width / outline width / arm width
server float gitd_shape_angle = 0.0;
server color gitd_shape_color = "ff 40 10";
server float gitd_shape_intensity = 1.6;
server float gitd_shape_life = 4.0;      // seconds; 0 = it never fades

// The split, and the colour underneath it.
server float gitd_shape_seam = 0.0;      // how far open it starts
server float gitd_shape_seam_rate = 0.35;// how fast it opens, per second
server float gitd_shape_grow = 0.0;      // size added per second
server color gitd_shape_under = "ff 26 10";

// Shared by all sixteen.
server float gitd_shape_soft = 2.0;      // edge softness. 0 is a hard cut,
                                         // which is what reads as projected
server float gitd_shape_height = 24.0;   // how far off its own plane a shape
                                         // still draws -- this is what keeps
                                         // it lying ON the floor
server float gitd_shape_reach = 0.0;     // a little glow past the edge

// What drops one.
server bool  gitd_shape_on_death = true; // a mark where a monster died
server bool  gitd_shape_on_shot = false; // and where you fired

// ---- Repeat: one slot, many copies -----------------------------------------
//
// Slots and patterns answer different questions and you want both.
//
// A SLOT is one distinct event: this monster, here, at this angle, fading on
// its own clock. Combat is made of those, and no pattern can express them
// because every copy in a pattern is necessarily identical.
//
// A PATTERN is many of the same thing at once, and it folds the coordinate
// rather than drawing N shapes -- so eight copies and eight hundred cost the
// same. It is still dynamic: the anchor is the slot's own position, so a
// formation follows an actor exactly as a single shape does.
//
//   0  a single shape
//   1  RADIAL -- count copies around a circle, spinning. Ritual circles,
//      summoning marks, a rune ring orbiting whatever it is anchored to.
//   2  GRID -- tiled out to an extent, drifting. Floor panels, scanlines,
//      a field of cracks.
server int   gitd_shape_repeat = 0;
server float gitd_shape_rep_count = 6.0;   // radial: how many. grid: extent
server float gitd_shape_rep_space = 96.0;  // radial: orbit radius. grid: spacing
server float gitd_shape_rep_spin = 20.0;   // deg/sec, or grid drift units/sec

// ---- The fog follows the architecture --------------------------------------
//
// A slab with one world Z is flat across the whole map -- knee deep in one
// room, overhead in the pit next door, and it does not climb a staircase.
// What "fog on the floor" actually means is a constant height ABOVE THE
// GROUND, which is a different question.
//
// One dial per EDGE, because floor fog and ceiling fog want opposite things:
// floor fog wants its TOP a fixed height above the floor; ceiling fog wants
// its BOTTOM a fixed depth below the ceiling.
//
//   0    absolute world Z, exactly as before
//   > 0  follow the FLOOR by this much
//   < 0  follow the CEILING by this much
//
// THE MAGNITUDE IS THE GENTLENESS and it is the useful part. At 1 the surface
// tracks every step exactly; at 0.3 it rises three units for every ten the
// floor does, so a staircase reads as a slope rather than a flight of steps.
// Fog that steps looks like geometry. Fog that lags looks like weather.
//
// The surface swell rides on top of whatever this produces, so the layer can
// climb a stair AND roll while it does it.
server float gitd_fog_follow_top = 0.35;      // ON: the layer climbs a staircase as a slope, which is what makes it read as weather rather than a plane
server float gitd_fog_follow_bottom = 0.55;   // the underside tracks harder than the top, so mist POOLS in low ground and thins on high

// ---- Fog colour from the lanes ---------------------------------------------
//
// The fog had one fixed colour while the four lanes cycled thirty-two around
// it, which reads as two mods running at once rather than one room.
//
//   0  the colour picker, as before
//   1  MATCH -- take the floor lane's current colour
//   2  COMPLEMENT -- take its opposite, so the mist is what the glow is not
//   3  RANDOM -- a fresh colour each time the lane changes slot
//
// Match makes the air agree with the room. Complement is the one worth trying
// first: cyan glow standing in orange mist reads as depth, because the two
// are separated in hue rather than in brightness alone.
//
// Applies to the layer; the tornado has its own, on its own page.
// 0 the picker, 1 match a lane, 2 complement a lane, 3 random per slot,
// 4 THE LIQUID YOU ARE NEAREST -- the one source that comes from the map
// rather than from this mod. FancyWorld read every flat in the level to place
// its emitters, so it already knows which sectors are nukage, blood, lava or
// water; this borrows that. Falls back to the lane sources where there is no
// pool in reach.
server int   gitd_fog_color_mode = 0;

// How far a pool can be and still colour the air. Standing in one wins
// outright regardless.
server float gitd_fog_color_liquid_range = 900.0;
server int   gitd_fog_color_lane = 3;    // 0 wb, 1 wt, 2 ceiling, 3 floor
server float gitd_fog_color_blend = 1.0; // how far toward it, 0..1

// How far "in front of you" is, for origin mode 6. Shared by the sweep, the
// glow wave and the tornado -- the same reason OriginFor is shared: three
// copies of "ahead" would drift into three different distances.
server float gitd_origin_ahead = 320.0;

// ============================================================================
//  FANCYWORLD -- ambience read off the map's own textures.
//
//  RESTORED after removal. The scan matches every sector flat and every wall
//  texture against a table and places emitters accordingly: a looping
//  ambient sound, a dynamic light in the colour the texture name implies,
//  and particles. Works on any WAD.
//
//  Held out of the restore, on a separate decision: gitd_voice (the four
//  preset dialects) and the sweep klaxon that rode it.
// ============================================================================

server bool  fw_enabled        = true;

// Light. Detail 1 lights only what the map already implies (lit ceiling flats,
// wall light textures, lavafalls, teleport pads, broken monitors); 2 adds
// flavour glow on slime, computers and the face texture.
server bool  fw_lights         = true;
server int   fw_light_detail   = 2;
server float fw_light_scale    = 1.0;

server bool  fw_particles      = true;
server float fw_particle_scale = 1.0;

// How close you must be for an emitter to make sound, light or particles.
// The biggest single performance lever in the scan.
server float fw_range          = 2048.0;

// Emitter spacing. Both apply on the next map, since they decide placement.
server int   fw_spacing        = 256;
server int   fw_wall_spacing   = 64;

// Footsteps. Doom has never had any; the material comes from the flat under
// you, through the same table machinery as everything else.
server bool  gitd_steps            = true;
server float gitd_steps_volume     = 1.0;
server float gitd_steps_stride     = 52.0;   // world units travelled per footfall

// Liquid flourishes. A ring spreads where something crosses a liquid's
// surface, a couple of bubbles rise after -- layered on the splash itself,
// which runs regardless of this cvar (see fancy_liquids.zs).
server bool fw_liquid_flourish = true;

// Muffle emitters you cannot see. A real sight trace, run only on things
// already in range and already audible.
//
// The amount is NOT 0 on purpose: a sight line is not an acoustic path. Sound
// goes round corners and under doors, and a waterfall down a bent corridor
// should still reach you -- just not as though it were in front of your face.
server bool  gitd_occlusion        = true;
server float gitd_occlusion_amount = 0.45;

// ============================================================================
//  Universal Map Enhancements -- the third component. Independent of
//  FancyWorld's fw_* cvars on purpose; see zscript/ume/ume_common.zs.
// ============================================================================

// Replaces every vanilla decoration that already animates BRIGHT (torches,
// tech lamps, the burning barrel) with a version that casts a real Shape
// light and breaks in one hit. See ume_decorations.zs for why those and not
// the columns/candles/skulls that don't already imply a light source.
server bool ume_decorations = true;

// Columns, impaled heads, trees and stalagmites break in one hit. Separate
// from ume_decorations because this changes what the world DOES rather than
// how it is lit -- and deliberately grants no glow: none of these are lit in
// vanilla. See ume_scenery.zs.
server bool ume_scenery = true;

// Keys carry their own light, in their own colour. Not cosmetic: this mod's
// whole premise is a map crushed toward black, and a keycard is a small flat
// sprite on a floor. Its own cvar because it is the one thing here that can
// affect whether a map is completable. See ume_keys.zs.
server bool ume_key_glow = true;

// How close you must be for a prop's light to exist at all. The Shape budget
// is 128 slots shared with kill marks, liquid rings and FancyWorld's own
// emitters, and a prop's light is permanent while it holds one -- so a hell
// map with sixty torches would exhaust the whole budget on lights nobody is
// near. Same default and same reasoning as fw_range.
server float ume_light_range = 2048.0;

// The sweep's air lattice is an infinite plane, so without a room it stands
// wherever that plane reaches -- including through windows, in rooms the
// sweep never entered. This bounds it to the space you are actually in.
// See zscript/SweepRoom.zs for how "the room" is decided.
server bool  gitd_ss_room      = true;
server float gitd_ss_room_soft = 96.0;   // fade distance at the edge, in units
