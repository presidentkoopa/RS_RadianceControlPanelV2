//============================================================================
// EDIT ONE BAND
//
// The eight sweep bands carry seven settings each. Listing all of them is 56
// rows, which is why the explicit per-band lists elsewhere in this file stop
// at the four everyone actually changes.
//
// GlowHandler's SaveSweep/LoadSweep/CommitSweep proxy exists to solve that: a
// working set of nine cvars plus a selector, with the handler writing the
// outgoing band and loading the incoming one as the selector moves. It was
// written, it works, and until now nothing in this file addressed it -- so the
// three settings with no explicit rows anywhere (effect amount, the per-band
// effect, and the band SCRIPT) were console-only.
//
// Edits go straight through to the selected band, so the sweep you are
// watching changes as you drag rather than when you next move the selector.
//============================================================================
OptionMenu "GITDSweepBand"
{
	Class "DarkDoomZ_OptionMenu"
	Title "Edit One Band"
	StaticText ""

	Option "Editing band",			"gitd_sw_sel", "GITDSweepCount"
	StaticText "Everything below edits THIS band. Move the", darkgray
	StaticText "selector and the rows reload for the next one;", darkgray
	StaticText "the band you were on is written first.", darkgray
	StaticText ""

	ColorPicker "Colour",			"gitd_sw_c"
	Slider "Speed",					"gitd_sw_speed", 5, 2000, 5, 0
	Option "Shape",					"gitd_sw_shape", "GITDSweepShapeB"
	Option "Does",					"gitd_sw_draw", "GITDSweepDraw"
	Slider "Thickness (0 = shared)","gitd_sw_thick", 0, 2048, 4, 0
	Slider "Time to the next band",	"gitd_sw_gap", 1, 210, 1, 0
	StaticText "Band 8 has no gap -- there is no ninth band.", darkgray
	StaticText ""

	StaticText "Effect", gold
	Option "This band does",		"gitd_sw_fx", "GITDSweepFx"
	Slider "  Amount",				"gitd_sw_amount", 0, 128, 4, 0
	StaticText ""

	StaticText "Script", gold
	TextField "Class to fire",		"gitd_sw_script"
	StaticText "A GITD_SweepEffect subclass, run as the band", darkgray
	StaticText "passes. The most open-ended thing a band can", darkgray
	StaticText "do, and it had no menu row at all until now.", darkgray
	StaticText "Leave blank for none.", darkgray
}
