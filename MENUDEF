// ---------------------------------------------------------------------------
// Bloom. Engine cvars reached by name -- no mirrors in this mod's cvarinfo,
// same rule as everywhere else here.
//
// Bloom is what makes glow read as EMISSIVE rather than as paint: a bright
// enough surface bleeds light past its own edges. It is off by default in
// this engine, and the threshold used to be hardcoded at 1.0, meaning only
// pixels already blown past white could bloom at all. The threshold slider
// is the one that matters for glow.
// ---------------------------------------------------------------------------

OptionMenu "GITDBloom"
{
	Class "DarkDoomZ_OptionMenu"
	Title "Bloom Options"
	StaticText ""
	StaticText "Makes bright surfaces bleed light past", darkgray
	StaticText "their edges -- what sells glow as emissive", darkgray
	StaticText ""
	Option "Bloom",					"gl_bloom", "OnOff"
	StaticText ""
	Slider "Threshold",				"gl_bloom_threshold", 0.05, 4.0, 0.05, 2
	StaticText "How bright something must be before it", darkgray
	StaticText "blooms. Lower = glow blooms at sane", darkgray
	StaticText "intensities instead of needing to be", darkgray
	StaticText "cranked past white first.", darkgray
	StaticText ""
	Slider "Softness",				"gl_bloom_knee", 0.0, 8.0, 0.1, 1
	StaticText "How gradually things start blooming as", darkgray
	StaticText "they brighten. 0 snaps on at the threshold,", darkgray
	StaticText "which pops when glow pulses or a beam", darkgray
	StaticText "sweeps past.", darkgray
	StaticText ""
	Slider "Amount",				"gl_bloom_amount", 0.1, 4.0, 0.1, 1
	StaticText "How far the light spreads", darkgray
	StaticText ""
	StaticText "Anamorphic", gold
	Option "Streak sideways",		"gl_bloom_anamorphic", "OnOff"
	Slider "  Stretch",				"gl_bloom_anamorphic_ratio", 1.0, 16.0, 0.5, 1
	StaticText "Blurs wider horizontally than vertically,", darkgray
	StaticText "so bright edges streak sideways like an", darkgray
	StaticText "anamorphic lens", darkgray
	StaticText ""
	StaticText "Colour", gold
	Slider "Tint red",				"gl_bloom_tint_r", 0.0, 2.0, 0.05, 2
	Slider "Tint green",			"gl_bloom_tint_g", 0.0, 2.0, 0.05, 2
	Slider "Tint blue",				"gl_bloom_tint_b", 0.0, 2.0, 0.05, 2
	StaticText "Colours the bloom regardless of what made", darkgray
	StaticText "it. All three at 1.00 leaves it alone.", darkgray
	StaticText ""
	Slider "Colour fringing",		"gl_bloom_chromatic", 0.0, 0.1, 0.002, 3
	StaticText "Splits the bloom's colour channels outward", darkgray
	StaticText "from screen centre, the way a real lens", darkgray
	StaticText "does. Nil in the middle, strongest at the", darkgray
	StaticText "edges.", darkgray
	StaticText ""
	StaticText "Exposure", gold
	StaticText "Bloom is measured after exposure, so these", darkgray
	StaticText "change what counts as bright", darkgray
	Slider "Scale",					"gl_exposure_scale", 0.1, 4.0, 0.05, 2
