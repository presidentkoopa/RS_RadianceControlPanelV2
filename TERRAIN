// ============================================================================
//  Liquid splashes -- the engine's own terrain system, not a scan.
// ============================================================================
//
//  See zscript/fw/fancy_liquids.zs for the actors these splash blocks name,
//  and the credits in README.md for where the assets behind them are from.
//
//  Broad coverage is deliberate and costs nothing: a flat this mod's own
//  FancyWorld table has never heard of, but that a loaded texture pack
//  ships, still gets a real splash -- `floor optional` silently skips
//  whatever isn't present in the currently loaded IWAD/PWAD rather than
//  erroring, so listing FreeDoom's and Eviternity's liquid flats here has
//  no cost when they're absent and a real one when they're not.
//
// ============================================================================

// ---- splashes --------------------------------------------------------------

splash MTOWater
{
	smallclass    MTOSplashBaseGreen
	smallclip     12
	smallsound    world/mtoliquid/water

	baseclass     MTOSplashBaseGreen
	chunkclass    MTOSplashChunkGreen
	chunkxvelshift 8
	chunkyvelshift 8
	chunkzvelshift 8
	chunkbasezvel 2
	sound         world/mtoliquid/water
	noalert
}

